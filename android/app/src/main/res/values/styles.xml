<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark, matching the game -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/qb_bg</item>
        <item name="colorPrimaryDark">@color/qb_bg</item>
        <item name="colorAccent">@color/qb_accent</item>
        <item name="android:windowBackground">@color/qb_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/qb_bg</item>
        <item name="android:statusBarColor">@color/qb_bg</item>
        <item name="android:navigationBarColor">@color/qb_bg</item>
    </style>

    <!-- Launch / splash: dark background with the app icon -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/qb_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
